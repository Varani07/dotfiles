_get_linguagens() {
    printf '%s\n' none python uv-python odin  
}

_get_projects() {
    local files_path="$HOME/.act_projects"
    [[ -f "$files_path" ]] || return 1 

    while read -r lines; do
        echo "${lines##*/}"
    done < "$files_path"
}
