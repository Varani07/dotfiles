_get_linguagens() {
    printf '%s\n' none python uv-python lua bash c-sharp go odin markdown  
}

_get_projects() {
    local files_path="$HOME/.act/projects"
    [[ -d "$files_path" ]] || return 1 

    for repo in "$files_path"/*; do
        echo "${repo##*/}"
    done
}
