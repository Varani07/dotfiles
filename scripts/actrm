#!/bin/bash


actrm() {
    local act_path="$HOME/.act"
    local act_file_path="${act_path}/act_projects"
    local cwd="$(pwd)"

    local OPTIND
    local erro=""

    while getopts ":h" opt; do
        case $opt in
            h)
                msg=()
                msg+=("actrm")
                printf "\n%s\n\n" "${msg[@]}"
                return 1
                ;;
            :) erro+="Flag -$OPTARG necessita de um argumento. " ;;
            \?) erro+="Flag -$OPTARG desconhecida. " ;;
        esac
    done

    [[ -n "$erro" ]] && echo "$erro" >&2 && return 1
    local temp=$(mktemp)

    local project_dir="${act_path}/projects/${cwd##*/}"
    if [[ ! -f "$project_dir" ]]; then
        echo "Projeto ${cwd##*/} não encontrado." >&2
        return 1
    else
        rm "$project_dir"
    fi

    while read -r path; do
        [[ "${path%%:*}" == "$cwd" ]] && continue
        echo "$path" >> "$temp"
    done < "$act_file_path"

    mv "$temp" "$act_file_path"
}
