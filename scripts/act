#!/bin/bash


source "./act_comp" 2>/dev/null || source "$HOME/repos/dotfiles/scripts/act_comp"

MINICONDA_PATH="$HOME/miniconda3"
UV_PATH=(/usr/lib/python*/site-packages/uv)

act() {
    local OPTIND

    local iniciar=false
    local vim=false
    local git_status=false
    local erro=""

    while getopts ":svg" opt; do
        case $opt in
            s) iniciar=true ;;
            v) vim=true ;;
            g) git_status=true ;;
            \?) erro+=$(printf "Flag -%s é inválida. " "$OPTARG") ;;
        esac
    done

    if [[ -n "$erro" ]]; then
        echo "$erro" >&2
        return 1
    fi

    shift $((OPTIND - 1))

    local repo="$1"
    local file="$HOME/.act/act_projects"
    if [[ ! -f "$file" ]]; then
        echo "Primeiro adicione um projeto." >&2
        return 1
    fi

    if [ -z "$repo" ]; then
        cd "$HOME" || return
        if [ -d "$MINICONDA_PATH" ]; then
            conda activate base
        fi
        if [[ -d "${UV_PATH[0]}" ]]; then
            deactivate 2>/dev/null
        fi
        return
    fi

    local current_line_repo=""
    local linguagem=""
    local ambiente=""
    local found_repo=false

    while read -r path; do
        current_line_repo="${path%%:*}"
        clean_path="${path//:/}"
        if [[ ${current_line_repo##*/} == "$repo" ]]; then
            if [ $(( ${#path} - ${#clean_path} )) -eq 1 ]; then
                linguagem="${path##*:}"
            else
                local resto="${path#*:}"
                linguagem="${resto%%:*}"
                ambiente="${resto##*:}"
            fi
            found_repo=true
            break
        fi
    done < "$file"

    if [[ "$found_repo" == true ]]; then
        cd "$current_line_repo" || return

        if [[ "$git_status" == true ]]; then
            git fetch
            git status
        fi

        case $linguagem in
            python | uv-python) 
                python_exe=""
                for py_exe in python3 python; do
                    if $py_exe --version >/dev/null 2>&1; then
                        python_exe=$py_exe
                    fi
                done
                if [[ -z "$python_exe" ]]; then
                    echo "Python não encontrado no sistema..." >&2
                    exit 1
                fi
                if [[ "$linguagem" == "python" ]]; then
                    if [[ -n "$ambiente" ]]; then
                        conda activate "$ambiente"
                    fi
                    if [[  "$iniciar" == true  ]]; then
                        $python_exe main.py
                    fi
                else
                    source "${current_line_repo}/.venv/bin/activate"
                    current_line_repo+="/src/${repo/-/_}"
                    cd "$current_line_repo" || return
                    if [[ "$iniciar" == true  ]]; then
                        uv run main.py
                    fi
                fi
                ;;
            c-sharp)
                if [ "$iniciar" = true ]; then
                    dotnet run
                fi
                ;;
            go)
                if [ "$iniciar" = true ]; then
                    go run .
                fi
                ;;
            odin)
                if [ "$iniciar" = true ]; then
                    odin run .
                fi
                ;;
        esac

        if [ "$vim" = true ]; then
            nvim "$current_line_repo"
        fi
    else
        echo "Repo não existe."
    fi
}

_act_completion() {
    local cur prev
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    case "$prev" in
        -*s*) COMPREPLY=( $(compgen -W "$(_get_ide)" -- "$cur") ) ;;
        *) COMPREPLY=( $(compgen -W "$(_get_projects)" -- "$cur") ) ;;
    esac
}
complete -F _act_completion act
