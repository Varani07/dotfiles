#!/bin/bash


MINICONDA_PATH="$HOME/miniconda3"
UV_PATH=(/usr/lib/python*/site-packages/uv)

act() {
    local OPTIND

    local iniciar=false
    local vim=false
    local git_status=false

    while getopts "svg" opt; do
        case $opt in
            s) iniciar=true ;;
            v) vim=true ;;
            g) git_status=true ;;
            *)
                echo "Flag inválida" >&2
                exit 1
                ;;
        esac
    done

    shift $((OPTIND - 1))

    local repo="$1"

    if [ -z "$repo" ]; then
        cd "$HOME" || return
        if [ -d "$MINICONDA_PATH" ]; then
            conda activate base
        fi
        if [[ -d "${UV_PATH[0]}" ]]; then
            deactivate 2>/dev/null
        fi
        return
    fi

    local file="$HOME/.act_projects"
    local current_line_repo=""
    local linguagem=""
    local ambiente=""
    local found_repo=false

    while read -r path; do
        current_line_repo="${path%%:*}"
        clean_path="${path//:/}"
        if [[ ${current_line_repo##*/} == "$repo" ]]; then
            if [ $(( ${#path} - ${#clean_path} )) -eq 1 ]; then
                linguagem="${path##*:}"
            else
                local resto="${path#*:}"
                linguagem="${resto%%:*}"
                ambiente="${resto##*:}"
            fi
            found_repo=true
            break
        fi
    done < "$file"

    if [[ "$found_repo" == true ]]; then
        cd "$current_line_repo" || return

        if [[ "$git_status" == true ]]; then
            git fetch
            git status
        fi

        case $linguagem in
            python | uv-python) 
                python_exe=""
                for py_exe in python3 python; do
                    if $py_exe --version >/dev/null 2>&1; then
                        python_exe=$py_exe
                    fi
                done
                if [[ -z "$python_exe" ]]; then
                    echo "Python não encontrado no sistema..." >&2
                    exit 1
                fi
                if [[ "$linguagem" == "python" ]]; then
                    if [[ -n "$ambiente" ]]; then
                        conda activate "$ambiente"
                    fi
                    if [[  "$iniciar" == true  ]]; then
                        $python_exe main.py
                    fi
                else
                    source "${current_line_repo}/.venv/bin/activate"
                    current_line_repo+="/src/${repo/-/_}"
                    cd "$current_line_repo" || return
                    if [[ "$iniciar" == true  ]]; then
                        uv run main.py
                    fi
                fi
                ;;
            c-sharp)
                if [ "$iniciar" = true ]; then
                    dotnet run
                fi
                ;;
            go)
                if [ "$iniciar" = true ]; then
                    go run .
                fi
                ;;
            odin)
                if [ "$iniciar" = true ]; then
                    odin run .
                fi
                ;;
        esac

        if [ "$vim" = true ]; then
            nvim "$current_line_repo"
        fi
    else
        echo "Repo não existe."
    fi
}

actadd() {
    local file="$HOME/.act_projects"
    local path="$(pwd)"

    touch "$file"

    [[ -z "$1" ]] && echo "Função precisa de pelo menos um argumento." && return
    local linguagem="$1"

    while IFS= read -r line; do
        project="${line%%:*}"
        if [[ "$path" = "$project" ]]; then
            echo "Projeto já registrado."
            return
        fi
    done < "$file"

    if [[ -n "$2" ]]; then
        echo "${path}:${linguagem}:${2}" >> "$file"
    else
        echo "${path}:${linguagem}" >> "$file"
    fi
}

actrm() {
    local file="$HOME/.act_projects"
    local cwd="$(pwd)"
    [[ -f "$file" ]] || return
    local temp=$(mktemp)

    while read -r path; do
        [[ "${path%%:*}" == "$cwd" ]] && continue
        echo "$path" >> "$temp"
    done < "$file"

    mv "$temp" "$file"
}

actls() {
    local file="$HOME/.act_projects"
    [[ -f "$file" ]] || return
    cat -n "$file"
}

_act_completion() {
    local cur prev
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    case "$prev" in
        -*s*) COMPREPLY=( $(compgen -W "$(_get_ide)" -- "$cur") ) ;;
        *) COMPREPLY=( $(compgen -W "$(_get_projects)" -- "$cur") ) ;;
    esac
}
complete -F _act_completion act

_actadd_completion() {
    local cur prev
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    if [[ "$prev" == "actadd" ]]; then
        COMPREPLY=( $(compgen -W "$(_get_linguagens)" -- "$cur") )
    else
        case "$prev" in
            python) 
                if [ -d "$MINICONDA_PATH" ]; then
                    COMPREPLY=( $(compgen -W "$(_get_conda_envs)" -- "$cur") ) 
                fi
                ;;
        esac
    fi
}
complete -F _actadd_completion actadd

_get_conda_envs() {
    local envs=()
    while read -r name _; do
        [[ $name == "#" || -z $name ]] && continue
        envs+=("$name")
    done < <(conda info --envs)
    printf '%s\n' "${envs[@]}"
}

_get_linguagens() {
    printf '%s\n' various python lua bash c-sharp go odin markdown uv-python
}

_get_projects() {
    local file="$HOME/.act_projects"
    [[ -f "$file" ]] || return

    while IFS= read -r line; do
        [[ -z $line ]] && continue
        local path="${line%%:*}"
        printf '%s\n' "${path##*/}"
    done < "$file"
}
