#!/bin/bash


source "./act_comp" 2>/dev/null || source "$HOME/repos/dotfiles/scripts/act_comp"

remove_last_slash() {
    local path="$1"
    if [[ "${path: -1}" == "/" ]]; then
        printf "%s" "${path%/}"
    else 
        printf "%s" "$path"
    fi
}

reload_file_f() {
    local re_type="$1"
    local path="$2"
    local repo="$3"
    local all_path="$path/act_projects"
    local file_path="$path/projects/$repo"

    if [[ -n "$re_type" ]]; then
        if [[ "$re_type" == "all" ]]; then
            if [[ -f "$all_path" ]]; then
                while read -r repo_to_rm; do
                    cd "$repo_to_rm" || return
                    actrm
                    cd - >/dev/null || return
                done < "$all_path"
            else
                echo "Primeiro adicione um projeto para usar -r." >&2
                return 1
            fi
        else
            if [[ -d "$file_path" ]]; then
                for file in "$file_path"/*; do
                    rm "$file" && touch "$file"
                done
            else
                echo "Primeiro adicione $repo para usar -r." >&2
                return 1
            fi
        fi
    fi
}

add_env() {
    local lang="$1"
    local repo="$2"
    local file_path="$HOME/.act/projects/$repo/env"
    local found=false

    [[ ! -f "$file_path" ]] && touch "$file_path"

    while read -r line; do
        [[ "$lang" == "$line" ]] && found=true
    done < "$file_path"

    [[ "$found" == false ]] && echo "$lang" >> "$file_path"
}

verifications() {
    local output="$1"

    local lang="${output%%:*}"
    local p_path="${output##*:}"

    output="${output#*:}"
    output="${output%:*}"

    local x_type="${output%%:*}"
    local x_path="${output##*:}"

    [[ ! -e "$x_path" ]] && echo "Caminho de execução informado não existe." >&2 && return 1
    [[ ! -d "$p_path" ]] && echo "Caminho de início informado não existe." >&2 && return 1

    case "$x_type" in
        d)
            [[ ! -d "$x_path" ]] && echo "Caminho de execução deve ser do tipo especificado (d)." >&2 && return 1
            ;;
        f)
            [[ ! -f "$x_path" ]] && echo "Caminho de execução deve ser do tipo especificado (f)." >&2 && return 1
            ;;
    esac

    case "$lang" in
        uv-python | python)
            [[ "$x_type" == "d" ]] && echo "Opção de execução inválida, use -t f." >&2 && return 1
            [[ "${x_path##*/}" != *.py ]] && echo "Arquivo de execução com extensão inválida." >&2 && return 1
            ;;
        odin)
            [[ "$x_type" == "f" && "${x_path##*/}" != *.odin ]] && echo "Arquivo de execução com extensão inválida." >&2 && return 1
            ;;
        bash)
            [[ "$x_type" == "d" ]] && echo "Opção de execução inválida, use -t f." >&2 && return 1
            ;;
    esac
    return 0
}

add_starting_point() {
    local lang="$1"
    local exec_type="${2:-d}"
    local start="$3"
    local from="$4"
    local curr_pos="$5"
    local repo="$6"
    local dir_path="$7"
    local no_starting_point="$8"
    dir_path+="/projects/$repo"
    local file_path="${dir_path}/starting_point"

    [[ ! -d "$dir_path" ]] && mkdir -p "$dir_path"
    [[ ! -f "$file_path" ]] && touch "$file_path"

    local output=""

    if [[ "$no_starting_point" == false ]]; then
        output+="$lang"
        output+=":$exec_type"
        if [[ -z "$start" ]]; then
            output+=":$curr_pos"
        else
            output+=":${curr_pos}/${start}"
        fi
        if [[ -z "$from" ]]; then
            output+=":$curr_pos"
        else
            output+=":${curr_pos}/${from}"
        fi

        if ! verifications "$output"; then
            return 1
        fi

        while read -r start_points; do
            [[ "$start_points" == "$output" ]] && echo "Ponto de partida já cadastrado." >&2 && return 1
        done < "$file_path"

        echo "$output" >> "$file_path"
    fi
}

actadd() {
    local OPTIND
    local dir_path="$HOME/.act"
    local file_path="${dir_path}/act_projects"
    local path=""
    path="$(pwd)"
    repo="${path##*/}"

    if [[ ! -d "$dir_path" ]]; then
        mkdir -p "$dir_path"
        if [[ -f "$HOME/.act_projects" ]]; then
            mv "$HOME/.act_projects" "$file_path"
        else
            touch "$file_path"
        fi
    elif [[ ! -f "$file_path" ]]; then
        mkdir -p "$dir_path" && touch "$file_path"
    fi

    local from_path=""
    local start_path=""
    local exec_type=""
    local no_starting_point=false
    local reload_file=""
    local erro=""

    while getopts ":p:x:t:hr:" opt; do
        case $opt in
            p) from_path="$(remove_last_slash "$OPTARG")";;
            x) start_path=$(remove_last_slash "$OPTARG");;
            t)
                exec_type="$OPTARG"
                if [[ "$exec_type" != "d" && "$exec_type" != "f" ]]; then
                    erro+="Flag -t só aceita d ou f. "
                fi
                ;;
            r)
                reload_file="$OPTARG"
                if [[ "$reload_file" != "file" && "$reload_file" != "all" ]]; then
                    erro+="Flag -r só aceita all ou file."
                fi
                ;;
            h)
                msg=()
                msg+=("actadd -r file various")
                msg+=("actadd -p path/ -x path/main.py -t f python")
                msg+=("actadd -p path/ -x path/here/ -t d odin")
                msg+=("Flags:")
                msg+=("p - Caminho por onde o projeto irá rodar.")
                msg+=("x - Caminho até diretório/arquivo que será executado.")
                msg+=("t - Tipo de execução (d ou f).")
                msg+=("r - Reload dos arquivos de config (all ou file).")
                printf "\n%s\n%s\n%s\n\n%s\n\n%s\n%s\n%s\n%s\n\n" "${msg[@]}"
                return 1
                ;;
            :) erro+="Flag -$OPTARG necessita de um argumento. " ;;
            \?) erro+="Flag -$OPTARG é inválida. " ;;
        esac
    done

    [[ -n "$erro" ]] && echo "$erro" >&2 && return 1
    shift $((OPTIND - 1))
    [[ -z "$1" ]] && echo "Função precisa de pelo menos um argumento." >&2 && return 1
    [[ -z "$exec_type" && -z "$start_path" && -z "$from_path" ]] && no_starting_point=true
    local linguagem="$1"

    reload_file_f "$reload_file" "$dir_path" "$repo"

    while read -r line; do
        project="${line%%:*}"
        if [[ "$path" == "$project" ]]; then
            add_starting_point "$linguagem" "$exec_type" "$start_path" "$from_path" "$path" "$repo" "$dir_path" "$no_starting_point"
            add_env "$linguagem" "$repo" 
            return 1
        fi
    done < "$file_path"
    
    if ! add_starting_point "$linguagem" "$exec_type" "$start_path" "$from_path" "$path" "$repo" "$dir_path" "$no_starting_point"; then
        return 1
    fi
    add_env "$linguagem" "$repo" 

    echo "$path" >> "$file_path"
}

_actadd_completion() {
    local cur prev
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    case "$prev" in
        # python) 
        #     if [ -d "$MINICONDA_PATH" ]; then
        #         mapfile -t COMPREPLY < <(compgen -W "$(_get_conda_envs)" -- "$cur")
        #     fi
        #     ;;
        -p)
            compopt -o filenames
            mapfile -t COMPREPLY < <(compgen -d -- "$cur")
            ;;
        -x)
            compopt -o filenames
            mapfile -t COMPREPLY < <(compgen -f -- "$cur")
            ;;
        *) mapfile -t COMPREPLY < <(compgen -W "$(_get_linguagens)" -- "$cur") ;;
    esac
}
complete -F _actadd_completion actadd
