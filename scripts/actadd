#!/bin/bash


source "./act_comp" 2>/dev/null || source "$HOME/repos/dotfiles/scripts/act_comp"
source "./act_utils" 2>/dev/null || source "$HOME/repos/dotfiles/scripts/act_utils"

remove_last_slash() {
    local path="$1"
    if [[ "${path: -1}" == "/" ]]; then
        printf "%s" "${path%/}"
    else 
        printf "%s" "$path"
    fi
}

reload_file_f() {
    local re_type="$1"
    local path="$2"
    local repo="$3"
    local all_path="$HOME/.act_projects"

    if [[ -n "$re_type" ]]; then
        if [[ "$re_type" == "all" ]]; then
            if [[ -f "$all_path" ]]; then
                local repo_to_rm; while read -r repo_to_rm; do
                    cd "$repo_to_rm" || return
                    actrm
                    cd - >/dev/null || return
                done < "$all_path"
            else
                echo "Primeiro adicione um projeto para usar -r." >&2
                return 1
            fi
        else
            if [[ -d "$path" ]]; then
                local file; for file in "$path"/*; do
                    rm "$file" && touch "$file"
                done
            else
                echo "Primeiro adicione $repo para usar -r." >&2
                return 1
            fi
        fi
    fi
}

add_env() {
    local lang="$1"
    local repo="$2"
    local no_env="$3"
    local file_path=".act/env"
    local found=false

    [[ ! -f "$file_path" ]] && touch "$file_path"

    if [[ "$no_env" == false ]]; then
        case "$lang" in
            python) echo "$lang não suportado como ambiente, alterado para none." && lang="none" ;;
            odin) echo "$lang não suportado como ambiente, alterado para none." && lang="none" ;;
            uv-python | none) : ;;
            *) echo "$lang não suportado como ambiente, alterado para none." && lang="none" ;;
        esac
    fi

    local env_file; mapfile -t env_file < "$file_path"
    [[ "${#env_file[@]}" == 0 && "$no_env" == true ]] && lang="none" && no_env=false

    local line; while read -r line; do
        [[ "$lang" == "$line" ]] && found=true
    done < "$file_path"

    [[ "$found" == false && "$no_env" == false ]] && echo "$lang" >> "$file_path"
    [[ "$found" == true && "$no_env" == false ]] && echo "Ambiente já cadastrado." >&2 && return 1
}

verifications() {
    local output="$1"

    local lang="${output%%:*}"
    local p_path="${output##*:}"

    output="${output#*:}"
    output="${output%:*}"

    local x_type="${output%%:*}"
    local x_path="${output##*:}"

    [[ ! -e "$x_path" ]] && echo "Caminho de execução informado não existe." >&2 && return 1
    [[ ! -d "$p_path" ]] && echo "Caminho de início informado não existe." >&2 && return 1

    case "$x_type" in
        d)
            [[ ! -d "$x_path" ]] && echo "Caminho de execução deve ser um diretório." >&2 && return 1
            ;;
        f)
            [[ ! -f "$x_path" ]] && echo "Caminho de execução deve ser um arquivo." >&2 && return 1
            ;;
    esac

    case "$lang" in
        uv-python | python)
            [[ "$x_type" == "d" ]] && echo "Opção de execução inválida." >&2 && return 1
            [[ "${x_path##*/}" != *.py ]] && echo "Arquivo de execução com extensão inválida." >&2 && return 1
            ;;
        odin)
            [[ "$x_type" == "f" && "${x_path##*/}" != *.odin ]] && echo "Arquivo de execução com extensão inválida." >&2 && return 1
            ;;
        bash)
            [[ "$x_type" == "d" ]] && echo "Opção de execução inválida." >&2 && return 1
            ;;
        none)
            [[ "$x_type" == "f" ]] && echo "Opção de execução inválida." >&2 && return 1
            ;;
        *) echo "Linguagem \"${lang}\" não configurada para execução." >&2 && return 1
    esac
    return 0
}

add_starting_point() {
    local lang="$1"
    local start="$2"
    local from="$3"
    local curr_pos="$4"
    local repo="$5"
    local dir_path="$6"
    local no_starting_point="$7"
    local file_path=".act/starting_point"

    local exec_type="d"

    [[ ! -f "$file_path" ]] && touch "$file_path"

    [[ -f "$start" ]] && exec_type="f"

    local output=""

    if [[ "$no_starting_point" == false ]]; then
        output+="$lang"
        output+=":$exec_type"
        if [[ -z "$start" ]]; then
            output+=":$curr_pos"
        else
            output+=":${curr_pos}/${start}"
        fi
        if [[ -z "$from" ]]; then
            output+=":$curr_pos"
        else
            output+=":${curr_pos}/${from}"
        fi

        if ! verifications "$output"; then
            return 1
        fi
        local start_points
        while read -r start_points; do
            [[ "$start_points" == "$output" ]] && echo "Ponto de partida já cadastrado." >&2 && return 1
        done < "$file_path"

        echo "$output" >> "$file_path"
    fi
}

actadd() {
    local OPTIND
    local dir_path=".act"
    local file_path="${HOME}/.act_projects"

    local path=""
    path="$(pwd)"
    local prev_path="$path"
    repo="${path##*/}"

    local linguagem="none"

    local from_path=""
    local start_path=""

    local no_env=false
    local no_starting_point=false

    local reload_file=""
    local erro=""

    [[ ! -f "$file_path" ]] && touch "$file_path"

    local opt; while getopts ":p:x:r:l:esh" opt; do
        case $opt in
            p) from_path="$(remove_last_slash "$OPTARG")";;
            x) start_path=$(remove_last_slash "$OPTARG");;
            r)
                reload_file="$OPTARG"
                if [[ "$reload_file" != "file" && "$reload_file" != "all" ]]; then
                    erro+="Flag -r só aceita all ou file."
                fi
                ;;
            l) linguagem="$OPTARG" ;;
            e) no_env=true ;;
            s) no_starting_point=true ;;
            h)
                msg=()
                msg+=("actadd -se init (init para inicialização do projeto)")
                msg+=("actadd -r file")
                msg+=("actadd -p path/ -x path/main.py -l python")
                msg+=("actadd -p path/ -x path/here/ -el odin")
                msg+=("Flags:")
                msg+=("p - Caminho por onde o projeto irá rodar.")
                msg+=("x - Caminho até diretório/arquivo que será executado.")
                msg+=("l - Linguagem (none)")
                msg+=("r - Reload dos arquivos de config (all ou file).")
                msg+=("e - Não adicionar environment.")
                msg+=("s - Não adicionar ponto de execução.")
                printf "\n%s\n%s\n%s\n%s\n\n%s\n\n%s\n%s\n%s\n%s\n%s\n%s\n\n" "${msg[@]}"
                return 1
                ;;
            :) erro+="Flag -$OPTARG necessita de um argumento. " ;;
            \?) erro+="Flag -$OPTARG é inválida. " ;;
        esac
    done

    [[ -n "$erro" ]] && echo "$erro" >&2 && return 1
    shift $((OPTIND - 1))

    if [[ -d ".act" ]]; then
        local found=false
        local line=""
        while read -r line; do
            [[ "$path" == "$line" ]] && found=true && break
        done < "$file_path"
        if [[ "$found" == true ]]; then
            [[ "$1" == "init" ]] && echo "Projeto já foi inicializado." >&2 && return 1
        else
            if [[ "$1" == "sync" ]]; then
                echo "$path" >> "$file_path" && echo "Projeto registrado." && return
            else
                echo "Sincronize o projeto com \"actadd sync\"" >&2 && return 1 
            fi
        fi
    else
        if [[ "$1" == "init" ]]; then
            mkdir ".act"
        else
            repo=$(_act_recursive_search "$repo" "$path") || return 1
            act "$repo"
            path="$(pwd)"
        fi
    fi

    reload_file_f "$reload_file" "$dir_path" "$repo"

    local line
    while read -r line; do
        project="${line%%:*}"
        if [[ "$path" == "$project" ]]; then
            add_starting_point "$linguagem" "$start_path" "$from_path" "$prev_path" "$repo" "$dir_path" "$no_starting_point"
            add_env "$linguagem" "$repo" "$no_env"
            cd "$prev_path"
            return 1
        fi
    done < "$file_path"
    
    if ! add_starting_point "$linguagem" "$start_path" "$from_path" "$prev_path" "$repo" "$dir_path" "$no_starting_point"; then
        return 1
    fi
    add_env "$linguagem" "$repo" "$no_env"

    echo "$path" >> "$file_path"
    [[ "$1" == "init" ]] && echo "Projeto registrado."
    cd "$prev_path"
}

_actadd_completion() {
    local cur prev
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    case "$prev" in
        # python) 
        #     if [ -d "$MINICONDA_PATH" ]; then
        #         mapfile -t COMPREPLY < <(compgen -W "$(_get_conda_envs)" -- "$cur")
        #     fi
        #     ;;
        -*p*)
            compopt -o filenames
            mapfile -t COMPREPLY < <(compgen -d -- "$cur")
            ;;
        -*x*)
            compopt -o filenames
            mapfile -t COMPREPLY < <(compgen -f -- "$cur")
            ;;
        -*l*) mapfile -t COMPREPLY < <(compgen -W "$(_get_linguagens)" -- "$cur") ;;
        -*r*) mapfile -t COMPREPLY < <(compgen -W "$(printf '%s\n' file all)" -- "$cur") ;;
    esac
}
complete -F _actadd_completion actadd
